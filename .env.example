# Copy to .env.local and fill in. Never commit .env.local.

# --- OCR model: any OpenAI-compatible API (Gemini for demos, a local Ollama model for tests)
API_KEY=
BASE_URL=
MODEL=

# --- Database (Tiger Data / Timescale Cloud, Postgres)
DATABASE_URL=
# "true" verifies the connection against Tiger's CA in src/server/db/tiger-ca.ts
DATABASE_SSL=true

# --- Clerk (authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# --- Cloudinary (stores each vial's photo, or a still from its video)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
